# Secrets
.env
.env.*
!.env.example
.identity.local.env
*.local.env

# Memory vault generated files
memory/.search-index.db
memory/index.json
memory/sessions/
memory/maintenance/
# Obsidian workspace state (config is tracked, workspace is not)
memory/.obsidian/workspace.json
memory/.obsidian/workspace-mobile.json
memory/.obsidian/cache

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# Tool caches / coverage artifacts
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Editor
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Quarantined (blocked) agent content — untrusted, never committed (keep README)
quarantine/*
!quarantine/README.md

# The agent catalog is refreshed weekly by a scheduled task; the committed
# seed (registry/catalog.seed.json) is what a fresh clone falls back to.
registry/catalog.json

# Where each item landed on THIS machine (global_path, installed_at). Tracking
# it made every checkout rewrite every entry, so two machines conflicted on
# each line and an un-bootstrapped one appeared to have agents it did not.
registry/installed.local.json
