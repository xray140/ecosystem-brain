# Secrets
.env
.env.*
!.env.example
.identity.local.env
*.local.env

# Memory vault generated files
memory/.search-index.db
memory/index.json
memory/sessions/
memory/maintenance/
# Obsidian workspace state (config is tracked, workspace is not)
memory/.obsidian/workspace.json
memory/.obsidian/workspace-mobile.json
memory/.obsidian/cache

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# Editor
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Quarantined (blocked) agent content — untrusted, never committed (keep README)
quarantine/*
!quarantine/README.md
