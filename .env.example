# GitHub token for the GitHub MCP server in .mcp.json
# Get via: gh auth token
GITHUB_TOKEN=ghp_...

# GitHub Copilot MCP token (if using the Copilot MCP in ~/.claude/settings.json)
GITHUB_COPILOT_TOKEN=ghp_...

# Ollama models directory — must be ASCII-safe (no accented chars in path)
# Required if your Windows username has special characters
OLLAMA_MODELS=D:\ollama-models\models

# --- Multi-LLM keys (names only here; real values go in .env, gitignored) ---
# Reserved names, not requirements: nothing in this repo reads them. They exist
# so whichever assistant you actually use picks its key up automatically (see
# docs/MULTI-LLM.md). Set the ones matching the tools you run; the rest stay
# unset, and the doctors will not report them as gaps.
#! optional: ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY, DEEPSEEK_API_KEY
# Anthropic API (scripts / SDK use outside Claude Code; frontier model: claude-fable-5)
ANTHROPIC_API_KEY=sk-ant-...
# Gemini CLI / API — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# OpenAI / Codex CLI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# DeepSeek (OpenAI-compatible, https://api.deepseek.com) — see docs/MULTI-LLM.md
DEEPSEEK_API_KEY=sk-...
