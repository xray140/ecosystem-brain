{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git commit*)", "command": "/d/Claude_projects/ecosystem-brain/hooks/scripts/guard-secrets.sh" },
          { "type": "command", "if": "Bash(git push*)",   "command": "/d/Claude_projects/ecosystem-brain/hooks/scripts/guard-secrets.sh" },
          { "type": "command", "if": "Bash(git push*)",   "command": "/d/Claude_projects/ecosystem-brain/hooks/scripts/guard-destructive.sh" },
          { "type": "command", "if": "Bash(rm *)",        "command": "/d/Claude_projects/ecosystem-brain/hooks/scripts/guard-destructive.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "if": "Write(*.py)", "command": "bash /d/Claude_projects/ecosystem-brain/hooks/scripts/fmt-python.sh" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "bash /d/Claude_projects/ecosystem-brain/hooks/scripts/log-session.sh" }]
      }
    ]
  },
  "_notes": {
    "matcher": "tool name only (Bash, Write, Edit)",
    "if": "permission-rule syntax — Write(*.py) matches by filename suffix, Write(**/*.py) does NOT work",
    "hooks_fire": "PostToolUse hooks fire without restart when settings.json is edited mid-session"
  }
}
